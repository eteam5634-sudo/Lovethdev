# Client-safe (browser) — Playground accepts either prefix
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: test account EMAILS only (safe). Never put passwords in VITE_/NEXT_PUBLIC_ vars.
VITE_TEST_MEMBER_EMAIL=iolawoyin62@gmail.com
VITE_TEST_ADMIN_EMAIL=eteam5634@gmail.com
VITE_TEST_SUPER_ADMIN_EMAIL=floravibe73@gmail.com

# Google / Discord Auth — enable in Supabase Dashboard → Authentication → Providers
# Discord/Google redirect URI:
#   https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# Site redirect URLs (Supabase Auth → URL Configuration):
#   http://localhost:5173/auth/callback
#   https://YOUR-PLAYGROUND-DOMAIN/auth/callback

