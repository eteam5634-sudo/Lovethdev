# Client-safe (browser)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Google Auth — enable in Supabase Dashboard → Authentication → Providers → Google
# Add Redirect URLs in Supabase Auth → URL Configuration:
#   http://localhost:3000/auth/callback
#   https://YOUR-PORTFOLIO-DOMAIN/auth/callback

# Server-only test login (Portfolio) — NEVER use NEXT_PUBLIC_ for passwords
# TEST_MEMBER_EMAIL=
# TEST_MEMBER_PASSWORD=
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# TEST_SUPER_ADMIN_EMAIL=
# TEST_SUPER_ADMIN_PASSWORD=

# Server-only for scripts/setup-test-accounts.mjs — NEVER expose in browser
# SUPABASE_SERVICE_ROLE_KEY=
